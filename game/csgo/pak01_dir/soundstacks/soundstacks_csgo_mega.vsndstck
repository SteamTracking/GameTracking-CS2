				input_name = "steamaudio_relative_position"
				input = "0"
			},
			{
				name = "occlusion_interval_timer"
				operator = "util_interval_timer"
				input_interval = "@public.occlusion_interval"
				input_start = "1.000000"
				output_interval_elapsed = "1.000000"
			},
			{
				name = "time_mixlayer_amount_curve"
				operator = "math_curve_2d"
				input = "@get_event_info.output_elapsed_time"
				input_execute = "@public.set_mixlayer_amount_enable"
				input_scale_x = "1.0"
				input_scale_y = "1.0"
				public_field_name = "public.time_mixlayer_amount_curve"
				output = "0.0"
			},
			{
				name = "soundmixer_set_mixlayer_amount"
				operator = "soundmixer_set_mixlayer_amount"
				input_execute = "@public.set_mixlayer_amount_enable"
				input = "@time_mixlayer_amount_curve.output"
				mixlayer = "@public.set_mixlayer_layer"
			},
			{
				name = "mixlayer_keepalive"
				operator = "soundevent_control"
				input_execute = "@public.set_mixlayer_amount_enable"
				input_add_dependent = "1"
				input_clear_dependencies = "@calc_mixlayer_terminate.output"
			},
			{
				name = "calc_mixlayer_terminate"
				operator = "math_float_eval"
				input_execute = "@public.set_mixlayer_amount_enable"
				input1 = "@time_mixlayer_amount_curve.output"
				input2 = "@get_event_info.output_elapsed_time"
