				expression = "_1 <= 0 || _2 >= _3"
			},
			{
				name = "velocity_seek"
				operator = "math_filter_float"
				input_execute = "@public.use_velocity_volume_curve"
				input_max_velocity = "@public.velocity_volume_seek_speed"
				input_reset = "1"
				input = "@public.velocity_magnitude"
