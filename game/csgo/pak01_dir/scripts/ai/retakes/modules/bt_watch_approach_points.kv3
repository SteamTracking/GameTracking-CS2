<!-- kv3 encoding:text:version{e21c7f3c-8a33-41c5-9977-a76d3a32aa0d} format:generic:version{7412167c-06e9-4698-aff2-e63eb59037e7} -->
// Face a spot enemies could come from and watch it for a few seconds.
{
	type = "sequencer"
	children =
	[
		{
			type = "decorator_random_approach_point"
			output = "WatchPoint"
		},
		{
			type = "action_look_at"
			input_location = "WatchPoint"
		},
		{
			type = "action_wait"
			wait_time_min = 2
			wait_time_max = 4
		}
	]
}
