// Datamaps that no entity class has, like modifiers and structs that only code fills

@BaseClass = CNetworkedSequenceOperation
[
	cycle(float) // FIELD_FLOAT32 m_flCycle
	sequenceName(string) // FIELD_UTLSTRING
	sequence(integer) // FIELD_INT32
]

@BaseClass = HullFlags_t
[
	aihull_human(boolean) // FIELD_BOOLEAN m_bHull_Human
	aihull_small_centered(boolean) // FIELD_BOOLEAN m_bHull_SmallCentered
	aihull_wide_human(boolean) // FIELD_BOOLEAN m_bHull_WideHuman
	HullDesc_tiny(boolean) // FIELD_BOOLEAN m_bHull_Tiny
	aihull_medium(boolean) // FIELD_BOOLEAN m_bHull_Medium
	HullDesc_tiny_centered(boolean) // FIELD_BOOLEAN m_bHull_TinyCentered
	aihull_large(boolean) // FIELD_BOOLEAN m_bHull_Large
	aihull_large_centered(boolean) // FIELD_BOOLEAN m_bHull_LargeCentered
	aihull_medium_tall(boolean) // FIELD_BOOLEAN m_bHull_MediumTall
	aihull_small(boolean) // FIELD_BOOLEAN m_bHull_Small
]

@BaseClass = hudtextparms_t
[
	channel(integer) // FIELD_UINT8 channel
	effect(integer) // FIELD_UINT8 effect
	x(float) // FIELD_FLOAT32 x
	y(float) // FIELD_FLOAT32 y
]

