// CPathSimple
@PointClass base(C_BaseEntity) = path_simple
[
	// component CPathQueryComponent
	closed_loop(boolean) // FIELD_BOOLEAN m_bClosedLoop
	input GetClosestDirToEntity(target_destination) : "Compute the closest direction along the path relative to the entity provided. (world space vector)" // PVAL_EHANDLE hEntity, returns PVAL_VEC3 retval, Pulse node
	input GetClosestPosToEntity(target_destination) : "Compute the closest position on the path relative to the entity provided. (world space vector)" // PVAL_EHANDLE hEntity, returns PVAL_VEC3 retval, Pulse node
	input GetClosestTValueToEntity(target_destination) : "Compute the closest T value on the path relative to the entity provided. (0.0 to 1.0 float value that defines the point along the spline)" // PVAL_EHANDLE hEntity, returns PVAL_FLOAT retval, Pulse node
	input GetDirAtTValue(float) : "Compute the Direction along the spline at the provided T Value of the spline. (world space vector)" // PVAL_FLOAT flTValue, returns PVAL_VEC3 retval, Pulse node
	input GetDistanceBetweenEntitiesAlongPath(api) // PVAL_EHANDLE hEntityA, PVAL_EHANDLE hEntityB, returns PVAL_FLOAT retval, Pulse node: Compute the distance along the path between provided Entity A and Entity B
	input GetPosAtTValue(float) : "Compute the position at the provided T Value of the spline. (world space vector)" // PVAL_FLOAT flTValue, returns PVAL_VEC3_WORLDSPACE retval, Pulse node
	input GetTValueAtDistanceOffset(api) // PVAL_FLOAT flTValue, PVAL_FLOAT flDistance, returns PVAL_FLOAT retval, Pulse node: Given a starting T value on the spline and a distance traveled on the spline, return the resulting T value.
	input SetEntityAtTValue(api) // PVAL_EHANDLE hEntity, PVAL_FLOAT flTValue, Pulse node: Set entity to the position of the provided T value of the spline (world space vector)
]

