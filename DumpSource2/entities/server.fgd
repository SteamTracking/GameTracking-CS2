	input GetCurrentMoverSpeed(void) : "Get the provided movers current speed (units per second)" // returns PVAL_FLOAT retval, Pulse node
	input GetMoverOffsetFromPath(void) : "Get the offset from the spline the mover rides at, in the movers own space" // returns PVAL_VEC3 retval, Pulse node
	input GetMoverT(void) : "Get the provided movers current T value on the spline" // returns PVAL_FLOAT retval, Pulse node
	input MoveToPathNode(target_destination) : "Move to the given path node by name." // PVAL_EHANDLE:path_node_mover hPathNode
	input Pause(void)
	input SetDistanceToReachMaxSpeed(float) // PVAL_FLOAT param
	input SetDistanceToReachZeroSpeed(float) // PVAL_FLOAT param
	input SetFaceEntity(target_destination) : "Face the specified entity." // PVAL_EHANDLE hEnt, Pulse node
	input SetFollowDistance(float) // PVAL_FLOAT param
	input SetFollowEntity(target_destination) : "Set the name of an entity that the mover should follow -- it will try to maintain a given distance from this entity along the path." // PVAL_EHANDLE hEnt, Pulse node
	input SetFollowEntityForward(target_destination) : "Set the name of an entity that the mover should follow forward along the path -- it will try to maintain a given distance from this entity along the path." // PVAL_EHANDLE hEnt, Pulse node
	input SetFollowEntityReverse(target_destination) : "Set the name of an entity that the mover should follow reverse along the path -- it will try to maintain a given distance from this entity along the path." // PVAL_EHANDLE hEnt, Pulse node
	input SetFollowMinimumSpeed(float) // PVAL_FLOAT param
	input SetFollowMoverConstraintType(integer) // PVAL_INT param
	input SetFollowMoverEntity(target_destination) : "Sets the name of another mover the entity should follow." // PVAL_EHANDLE:func_mover pMover, Pulse node
	input SetFollowMoverEntityToClosestOnSpline(void)
	input SetFollowMoverSpringStrength(integer) // PVAL_INT param
	input SetMoveType(integer) // PVAL_INT param
	input SetMoveTypeEnum(string) : "Set the movers movement mode." // PVAL_SCHEMA_ENUM:CFuncMover::Move_t eMoveType, Pulse node
	input SetMoverFaceEntity(target_destination) : "Set the movers face entity" // PVAL_EHANDLE hFaceEntity, Pulse node
	input SetMoverOffsetFromPath(vector) : "Set the offset from the spline the mover rides at, in the movers own space. The mover snaps to the new offset, its location along the path is unchanged." // PVAL_VEC3 vOffset, Pulse node
	input SetOffsetFromPath(vector) // PVAL_VEC3 param
	input SetOrientationMode(integer) // PVAL_INT param
	input SetSpeed(float) // PVAL_FLOAT param
	input SetSpeedImmediate(float) // PVAL_FLOAT param
	input SetTimeToBlendToNewOrientation(float) // PVAL_FLOAT param
	input SetTimeToReachMaxSpeed(float) // PVAL_FLOAT param
	input SetTimeToReachZeroSpeed(float) // PVAL_FLOAT param
	input Start(void)
	input StartForward(void)
	input StartReverse(void)
	input Stop(void)
	input StopImmediate(void)
	input TeleportToPathNode(target_destination) : "Teleport to the given path node by name." // PVAL_EHANDLE:path_node_mover hPathNode, Pulse node
	input Toggle(void)
	input ToggleDirection(void)
	input TransitionToPath(target_destination) : "Transition to the given path by name. This is used to move the mover between seperate paths. Will pick the closest point on the target path to move to." // PVAL_EHANDLE:path_mover hPath
	input TransitionToPathNode(target_destination) : "Transition to the given path node by name. This is used to move the mover between seperate paths." // PVAL_EHANDLE:path_node_mover hPathNode
	input TransitionToPathNodeStartForward(target_destination) : "Transition to the given path node by name. This is used to move the mover between seperate paths. Will issue a start forward upon arriving at the node." // PVAL_EHANDLE:path_node_mover hPathNode, Pulse node
	input TransitionToPathNodeStartReverse(target_destination) : "Transition to the given path node by name. This is used to move the mover between seperate paths. Will issue a start reverse upon arriving at the node." // PVAL_EHANDLE:path_node_mover hPathNode, Pulse node
	input TransitionToPathStartForward(target_destination) : "Transition to the given path by name. This is used to move the mover between seperate paths. Will issue a start forward upon arriving at the path. Will pick the closest point on the target path to move to." // PVAL_EHANDLE:path_mover hPath, Pulse node
	input TransitionToPathStartReverse(target_destination) : "Transition to the given path by name. This is used to move the mover between seperate paths. Will issue a start reverse upon arriving at the path. Will pick the closest point on the target path to move to." // PVAL_EHANDLE:path_mover hPath, Pulse node
	input Unpause(void)
	output OnMovementEnd(void)
	output OnNodePassed(string) // PVAL_STRING param
	output OnStart(void)
	output OnStartForward(void)
	output OnStartReverse(void)
	output OnStop(void)
	output OnStopped(void)
	output OnTransitionToPathNodeComplete(void)
]

